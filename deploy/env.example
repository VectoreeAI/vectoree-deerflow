# 由部署脚本在第一次部署时复制成 /opt/vectoree-deerflow/.env。
# 之后每次部署只把这里新增、而 .env 里还没有的配置项追加进去，已有的值不动。
# 每次部署 CI 都会覆盖：
#   DEERFLOW_*_IMAGE
#   VECTOREE_API_URL：dev -> https://vectoree.net，main -> https://vectoree.ai
#   DEPLOY_MODE=cloud
#   DEER_FLOW_PUBLIC_BASE_PATH=/deerflow
# 已有的 BETTER_AUTH_SECRET 与 DEER_FLOW_INTERNAL_AUTH_TOKEN 不会被覆盖。
DEERFLOW_GATEWAY_IMAGE=
DEERFLOW_FRONTEND_IMAGE=
VECTOREE_API_URL=https://vectoree.ai
# local: 没有项目密钥时进入关联页。cloud: 不进入关联页。
DEPLOY_MODE=cloud
# 站点公网前缀。宿主机反向代理把 https://<公网入口>/deerflow/* 原样（不去前缀）转发到
# 127.0.0.1:${DEERFLOW_WEB_PORT}，预览入口是 https://<公网入口>/deerflow?ticket=…。
# 必须与前端镜像构建时的 NEXT_PUBLIC_BASE_PATH 一致。
DEER_FLOW_PUBLIC_BASE_PATH=/deerflow
DEERFLOW_WEB_PORT=5174
BETTER_AUTH_SECRET=
DEER_FLOW_INTERNAL_AUTH_TOKEN=
# 生图、生视频、语音默认模型。留空则从项目模型目录取第一个对应模态的模型。
VECTOREE_IMAGE_MODEL=bytedance-seed/seedream-5-0-pro
VECTOREE_VIDEO_MODEL=alibaba/wan-3.0
VECTOREE_SPEECH_MODEL=sesame/csm-1b
